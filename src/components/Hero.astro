---
import { TOKEN_CONFIG } from '../data/brothers';
---

<section id="dos-prompt" class="max-w-7xl mx-auto px-4 py-8">
  
  <!-- IBM / MS-DOS System Boot Window -->
  <div class="dos-box p-4 sm:p-6 text-[#ffffff] font-dos text-xl sm:text-2xl leading-snug">
    
    <!-- BIOS Header -->
    <div class="border-b-2 border-[#55ffff] pb-3 mb-4 text-[#55ffff]">
      <div>BROTHER-BIOS (C) 2024-2026 STARKNET MEME CORP. ALL RIGHTS RESERVED.</div>
      <div class="text-[#aaaaaa] text-lg">REVOLUTION PROTOCOL: HARDSHIP TO ETERNAL GLORY // CAIRO v2.8.4 KERNEL</div>
      <div class="text-[#ffff55] text-lg">PUBLIC IRC GATEWAY: irc.starknet.brother:6667 #BROTHERHOOD // 640KB BASE OK</div>
    </div>

    <!-- Hardship to Revolution Narrative in ASCII Box -->
    <div class="bg-[#000080] border border-[#ffffff] p-4 my-4 text-[#ffffff] text-lg sm:text-xl font-mono-code leading-relaxed">
      <div class="text-[#ffff55] font-bold mb-2">
        *** SYSTEM TRANSMISSION: THE BROTHER REVOLUTION ***
      </div>
      <p class="mb-2 text-[#55ffff]">
        [YEAR 2024] - THE HARD TIMES:
        In the depths of surveillance capitalism and brutal crypto winters, brothers held with zero cabal support, sleepless trading nights, and pure unwavering diamond hands.
      </p>
      <p class="text-[#55ff55]">
        [CURRENT ERA] - THE STARKNET REVOLUTION:
        Today, Starknet leads the world with STARK zero-knowledge proofs. We built $BROTHER not as a short-lived joke, but as a permanent digital brotherhood with 100% locked liquidity on unruggable.meme.
      </p>
    </div>

    <!-- mIRC / OLD SCHOOL RETRO IRC CHAT WINDOW -->
    <div class="mt-6 win31-window text-black font-mono-code text-sm">
      
      <!-- mIRC Titlebar -->
      <div class="win31-titlebar flex items-center justify-between text-xs sm:text-sm">
        <div class="flex items-center gap-2">
          <span class="bg-[#c0c0c0] text-black px-1 font-bold border border-white">#</span>
          <span>mIRC32 - [#BROTHERHOOD: Starknet Brothers Live Chat]</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="text-[11px] bg-[#008080] px-1.5 py-0.2 text-white border border-white">TOPIC: BROTHERCYCLE (REAL)</span>
          <button class="bg-[#c0c0c0] text-black px-1.5 font-bold border border-white text-xs">▲</button>
          <button class="bg-[#c0c0c0] text-black px-1.5 font-bold border border-white text-xs">■</button>
        </div>
      </div>

      <!-- mIRC Menu & Channel Mode Bar -->
      <div class="bg-[#c0c0c0] border-b border-[#808080] px-2 py-0.5 flex flex-wrap items-center justify-between text-xs select-none gap-2">
        <div class="flex items-center gap-3">
          <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>F</u>ile</span>
          <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>V</u>iew</span>
          <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>C</u>ommands</span>
          <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>W</u>indow</span>
          <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>H</u>elp</span>
        </div>
        <div class="flex items-center gap-3 text-[11px] text-[#000080] font-bold">
          <span>Channel: #BROTHERHOOD</span>
          <span>Modes: [+tns]</span>
          <span class="text-emerald-700 flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="sync-status">[P2P Matrix Live]</span>
          </span>
        </div>
      </div>

      <!-- Main Chat Body: Messages (Left) + Nicklist (Right) -->
      <div class="grid grid-cols-1 md:grid-cols-12 bg-black border-2 border-black">
        
        <!-- Messages Log Window -->
        <div id="mirc-messages" class="md:col-span-9 p-3 h-72 sm:h-80 overflow-y-auto space-y-1 text-xs sm:text-sm font-mono-code bg-[#000000] text-[#55ff55] scrollbar-thin">
          <div class="text-[#aaaaaa]">* Connecting to #BROTHERHOOD Global Live Network...</div>
          <div class="text-[#55ff55]">* Connected! Syncing live across all online browsers & devices.</div>
          <div class="text-[#ffff55] font-bold">* Topic for #BROTHERHOOD: "From Hardship to Revolution. Decades, not days. 100% Unruggable LP"</div>
          <div class="border-b border-[#333333] my-1"></div>
          
          <div><span class="text-[#ff5555] font-bold">&lt;@Maxx&gt;</span> Zero user acquisition cost when passion is maximum. Welcome brothers!</div>
          <div><span class="text-[#d946ef] font-bold">&lt;@Odin&gt;</span> A brother alone is strong. Brothers together are unstoppable.</div>
          <div><span class="text-[#3b82f6] font-bold">&lt;+Sam&gt;</span> Cairo contracts running on STARK proofs. Zero downtime.</div>
          <div><span class="text-[#f97316] font-bold">&lt;+Yoyo&gt;</span> Rise by lifting others! Who is diamond handing through the dip? 💎</div>
          <div><span class="text-[#eab308] font-bold">&lt;+Lyskey&gt;</span> Logging every transaction into permanent lore archives.</div>
          <div><span class="text-[#10b981] font-bold">&lt;+Cudan&gt;</span> Liquidity is 100% locked on unruggable.meme. Never fading.</div>
          <div><span class="text-[#55ffff] font-bold">&lt;+OneFarmer&gt;</span> Cultivating on Starknet daily. We build what lasts! 🚜</div>
        </div>

        <!-- mIRC Nicklist (Right Sidebar) -->
        <div class="hidden md:block md:col-span-3 bg-[#ffffff] border-l-2 border-[#808080] p-2 h-72 sm:h-80 overflow-y-auto text-xs font-mono-code text-black select-none">
          <div class="font-bold text-[11px] text-[#000080] border-b border-gray-300 pb-1 mb-1">
            ONLINE NICKLIST
          </div>
          <ul class="space-y-0.5" id="nicklist-ul">
            <li class="font-bold text-red-700 flex items-center gap-1"><span>@</span>Maxx <span class="text-[9px] text-gray-500">[Team]</span></li>
            <li class="font-bold text-purple-700 flex items-center gap-1"><span>@</span>Odin <span class="text-[9px] text-gray-500">[Elder]</span></li>
            <li class="font-bold text-blue-700 flex items-center gap-1"><span>+</span>Sam <span class="text-[9px] text-gray-500">[TechGod]</span></li>
            <li class="font-bold text-orange-700 flex items-center gap-1"><span>+</span>Yoyo <span class="text-[9px] text-gray-500">[OGs]</span></li>
            <li class="font-bold text-amber-700 flex items-center gap-1"><span>+</span>Lyskey <span class="text-[9px] text-gray-500">[Historian]</span></li>
            <li class="font-bold text-emerald-700 flex items-center gap-1"><span>+</span>Cudan <span class="text-[9px] text-gray-500">[OGs]</span></li>
            <li class="font-bold text-teal-700 flex items-center gap-1"><span>+</span>OneFarmer <span class="text-[9px] text-gray-500">[OGs]</span></li>
            <li class="text-gray-600 italic text-[11px] pt-1 border-t border-gray-200" id="current-user-nick">+AnonBro [You]</li>
          </ul>
        </div>

      </div>

      <!-- mIRC Chat Input Bar -->
      <div class="bg-[#c0c0c0] p-2 border-t-2 border-[#ffffff] flex items-center gap-2">
        <div class="flex items-center gap-1">
          <span class="text-[11px] font-bold text-black">NICK:</span>
          <input 
            type="text" 
            id="mirc-nick-input" 
            value="AnonBro" 
            maxlength="15"
            class="w-20 sm:w-24 bg-white border border-black px-1.5 py-0.5 text-xs text-black font-bold font-mono-code focus:outline-none"
            title="Change your chat handle"
          />
        </div>

        <input 
          type="text" 
          id="mirc-msg-input" 
          placeholder="Type message and press Enter to chat across the world in #BROTHERHOOD..."
          class="flex-1 bg-white border-2 border-black px-2 py-1 text-xs sm:text-sm text-black font-mono-code focus:outline-none"
          autocomplete="off"
        />

        <button 
          id="mirc-send-btn"
          type="button"
          class="win31-btn px-4 py-1 text-xs font-bold text-black cursor-pointer active:translate-x-0.5 active:translate-y-0.5"
        >
          SEND
        </button>
      </div>

    </div>

    <!-- Quick Tool Bar / Action Buttons -->
    <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3">
      <button 
        type="button" 
        data-cmd="BUY"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">💾</span>
        <span>BUY_AVNU.SYS</span>
      </button>

      <button 
        type="button" 
        data-cmd="MANIFESTO"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">📄</span>
        <span>MANIFESTO.TXT</span>
      </button>

      <button 
        type="button" 
        data-cmd="ROSTER"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">👥</span>
        <span>ROSTER.EXE</span>
      </button>

      <button 
        type="button" 
        data-cmd="MEME"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">🎨</span>
        <span>PAINT_MEME.EXE</span>
      </button>

      <button 
        type="button" 
        data-cmd="GECKO"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">🦎</span>
        <span>GECKOTERM.COM</span>
      </button>

      <button 
        type="button" 
        data-cmd="CONTRACT"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">📋</span>
        <span>COPY_CA.BAT</span>
      </button>
    </div>

  </div>

</section>

<!-- PieSocket WebSocket library from CDN for fast multi-window live chat -->
<script is:inline src="https://unpkg.com/piesocket-js@5"></script>

<script>
  const messagesBox = document.getElementById('mirc-messages');
  const nickInput = document.getElementById('mirc-nick-input') as HTMLInputElement;
  const msgInput = document.getElementById('mirc-msg-input') as HTMLInputElement;
  const sendBtn = document.getElementById('mirc-send-btn');
  const currentUserNick = document.getElementById('current-user-nick');
  const quickBtns = document.querySelectorAll('.quick-cmd-btn');
  const syncStatus = document.getElementById('sync-status');

  const contractAddress = "0x03b405a98c9e795d427fe82cdeeeed803f221b52471e3a757574a2b4180793ee";

  // Unique session ID
  const mySessionId = 'user_' + Math.random().toString(36).substring(2, 9);

  // Random nickname if not already picked
  let myNick = localStorage.getItem('brother_irc_nick') || ('Bro_' + Math.floor(100 + Math.random() * 900));
  if (nickInput) nickInput.value = myNick;
  if (currentUserNick) currentUserNick.textContent = `+${myNick} [You]`;

  nickInput?.addEventListener('input', () => {
    myNick = nickInput.value.trim() || 'AnonBro';
    localStorage.setItem('brother_irc_nick', myNick);
    if (currentUserNick) currentUserNick.textContent = `+${myNick} [You]`;
  });

  const seenMessages = new Set<string>();

  function escapeHtml(str: string) {
    return str.replace(/[&<>'"]/g, 
      tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
    );
  }

  function appendChatMessage(id: string, nick: string, text: string, isSelf = false) {
    if (!messagesBox || seenMessages.has(id)) return;
    seenMessages.add(id);

    const line = document.createElement('div');
    const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

    line.innerHTML = `<span class="text-[#555555]">[${time}]</span> <span class="${isSelf ? 'text-[#ffff55]' : 'text-[#55ffff]'} font-bold">&lt;${isSelf ? '+' : ''}${escapeHtml(nick)}&gt;</span> <span class="text-white">${escapeHtml(text)}</span>`;
    messagesBox.appendChild(line);
    messagesBox.scrollTop = messagesBox.scrollHeight;
  }

  // --- Real-time Relay 1: Public WebSockets via PieSocket Free Demo API ---
  let pieSocketChannel: any = null;
  try {
    if (typeof (window as any).PieSocket !== 'undefined') {
      const pieSocket = new (window as any).PieSocket({
        clusterId: "free.blr2",
        apiKey: "d3j8K4oO0b6f9Gz2A5vP7sC1lE8rY6mN", // Free public testing API key
        notifySelf: false
      });

      pieSocket.subscribe('supbro-brotherhood-live').then((ch: any) => {
        pieSocketChannel = ch;
        if (syncStatus) syncStatus.textContent = '[WebSocket Active]';
        ch.listen('chat_message', (payload: any) => {
          if (payload && payload.id && payload.text && payload.nick) {
            appendChatMessage(payload.id, payload.nick, payload.text, payload.senderId === mySessionId);
          }
        });
      }).catch((e: any) => {
        console.log('PieSocket connect note:', e);
      });
    }
  } catch(e) {
    console.log('WS init note:', e);
  }

  // --- Real-time Relay 2: Cross-Window localStorage event sync (guaranteed instant between windows) ---
  window.addEventListener('storage', (e) => {
    if (e.key === 'starknet_brother_live_sync' && e.newValue) {
      try {
        const payload = JSON.parse(e.newValue);
        if (payload && payload.id && payload.text && payload.nick) {
          appendChatMessage(payload.id, payload.nick, payload.text, payload.senderId === mySessionId);
        }
      } catch (err) {}
    }
  });

  // --- Real-time Relay 3: BroadcastChannel (same browser different tabs/windows) ---
  const bc = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel('starknet_brother_live_irc') : null;
  if (bc) {
    bc.onmessage = (e) => {
      if (e.data && e.data.id && e.data.text && e.data.nick) {
        appendChatMessage(e.data.id, e.data.nick, e.data.text, e.data.senderId === mySessionId);
      }
    };
  }

  // Send message
  function sendChatMessage() {
    if (!msgInput) return;
    const text = msgInput.value.trim();
    if (!text) return;

    const nick = (nickInput?.value.trim()) || myNick;
    const msgId = 'msg_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7);

    // 1. Show locally immediately
    appendChatMessage(msgId, nick, text, true);

    const payload = {
      id: msgId,
      nick: nick,
      text: text,
      senderId: mySessionId,
      time: Date.now()
    };

    // 2. Broadcast via localStorage (triggers 'storage' event across ALL other windows immediately)
    localStorage.setItem('starknet_brother_live_sync', JSON.stringify(payload));

    // 3. Broadcast via BroadcastChannel
    if (bc) {
      bc.postMessage(payload);
    }

    // 4. Broadcast via WebSocket if connected
    if (pieSocketChannel) {
      try {
        pieSocketChannel.publish('chat_message', payload);
      } catch(e) {}
    }

    msgInput.value = '';

    // Bot triggers
    triggerBotReply(text);
  }

  // Automated Starknet network bots
  function triggerBotReply(text: string) {
    const upper = text.toUpperCase();
    if (upper.includes('CA') || upper.includes('CONTRACT')) {
      setTimeout(() => {
        const id = 'bot_' + Date.now();
        appendChatMessage(id, 'Bot_Starkscan', `Official $BROTHER CA: ${contractAddress}`, false);
      }, 1000);
    } else if (upper.includes('PRICE') || upper.includes('PUMP')) {
      setTimeout(() => {
        const id = 'bot_' + Date.now();
        appendChatMessage(id, 'Bot_Avnu', 'Check live charts on DexScreener or GeckoTerminal. 100% Unruggable liquidity!', false);
      }, 1200);
    } else if (upper.includes('GM') || upper.includes('HI') || upper.includes('HELLO')) {
      setTimeout(() => {
        const bots = ['Maxx', 'Yoyo', 'Sam', 'OneFarmer'];
        const chosen = bots[Math.floor(Math.random() * bots.length)];
        const id = 'bot_' + Date.now();
        appendChatMessage(id, chosen, 'GM brother! Welcome to the revolution.', false);
      }, 1500);
    }
  }

  msgInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') sendChatMessage();
  });
  sendBtn?.addEventListener('click', sendChatMessage);

  // Quick Action Buttons
  quickBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-cmd');
      if (cmd === 'BUY') {
        window.open('https://app.avnu.fi/en?amount=0.1&tokenFrom=0x4718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d&tokenTo=0x3b405a98c9e795d427fe82cdeeeed803f221b52471e3a757574a2b4180793ee', '_blank');
      } else if (cmd === 'MANIFESTO') {
        const manEl = document.getElementById('manifesto') || document.getElementById('manifesto-teaser');
        if (manEl) manEl.scrollIntoView({ behavior: 'smooth' });
      } else if (cmd === 'ROSTER') {
        const hofEl = document.getElementById('hall-of-fame');
        if (hofEl) hofEl.scrollIntoView({ behavior: 'smooth' });
      } else if (cmd === 'MEME') {
        const memeEl = document.getElementById('meme-maker');
        if (memeEl) memeEl.scrollIntoView({ behavior: 'smooth' });
      } else if (cmd === 'GECKO') {
        window.open('https://www.geckoterminal.com/starknet-alpha/pools/0x00d4cf27867a524d5da0eb8a9d570506c9db85ee8fce7a90e4c5f8488251360a', '_blank');
      } else if (cmd === 'CONTRACT') {
        navigator.clipboard.writeText(contractAddress);
        appendChatMessage('sys_' + Date.now(), 'System', `Contract address copied: ${contractAddress}`, false);
      }
    });
  });
</script>
