---
import { TOKEN_CONFIG } from '../data/brothers';
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Hero Brand Badge / Logo -->
    <div class="inline-flex flex-col items-center mb-8">
      <div class="relative group mb-6">
        <div class="absolute -inset-1.5 bg-gradient-to-r from-blue-600 via-indigo-500 to-sky-500 rounded-3xl blur-xl opacity-50 group-hover:opacity-80 transition duration-500"></div>
        <div class="relative w-28 h-28 sm:w-36 sm:h-36 rounded-3xl overflow-hidden ring-4 ring-slate-800 shadow-2xl bg-slate-900">
          <img 
            src="/image/logo.jpeg" 
            alt="Starknet Brother Logo" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            onerror="this.src='/favicon.png'"
          />
        </div>
      </div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-mono mb-4">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
        <span>THE LEADING MEME TOKEN ON STARKNET</span>
      </div>
    </div>

    <!-- Main Title -->
    <h1 class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl tracking-tight text-white leading-[1.08] mb-6">
      WE ARE <br class="hidden sm:inline"/>
      <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-400 bg-clip-text text-transparent">
        STARKNET BROTHERS
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed mb-10">
      Built on Starknet, powered by brothers, and ready to take on the meme world! 
      Get in, hold tight, and let’s see where this wild ride takes us.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-10">
      <a 
        href={TOKEN_CONFIG.avnuBuyUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-8 py-4 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-sm shadow-xl shadow-blue-600/30 hover:shadow-blue-600/50 transition-all flex items-center gap-2.5 group"
      >
        <span>Buy $BROTHER on AVNU</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a 
        href="/manifesto" 
        class="px-8 py-4 rounded-2xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white font-bold text-sm border border-slate-700/80 hover:border-slate-600 transition-all flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>The Brother Manifesto</span>
      </a>

      <a 
        href={TOKEN_CONFIG.dexScreenerUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-6 py-4 rounded-2xl bg-slate-900/60 hover:bg-slate-800 text-slate-400 hover:text-white font-medium text-sm border border-slate-800 transition-all flex items-center gap-2"
      >
        <span>Live Chart</span>
        <span class="text-xs text-slate-500">↗</span>
      </a>
    </div>

    <!-- Contract Quick Bar -->
    <div class="inline-flex flex-col sm:flex-row items-center justify-center gap-3">
      <div class="inline-flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-slate-900/90 border border-slate-800 text-xs font-mono text-slate-400 shadow-lg">
        <span class="text-slate-500 font-semibold">CA:</span>
        <span class="text-slate-300 font-semibold tracking-wide">
          {TOKEN_CONFIG.contractAddress.slice(0, 10)}...{TOKEN_CONFIG.contractAddress.slice(-8)}
        </span>
        <button 
          id="copy-ca-btn"
          data-ca={TOKEN_CONFIG.contractAddress}
          class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-blue-400 rounded-lg text-xs font-sans transition-all cursor-pointer"
        >
          Copy
        </button>
      </div>

      <span class="text-xs text-emerald-400 flex items-center gap-1.5 px-3 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 font-mono">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        Liquidity 100% Locked
      </span>
    </div>

  </div>
</section>

<script>
  // Copy Contract Address functionality
  const copyBtn = document.getElementById('copy-ca-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const ca = copyBtn.getAttribute('data-ca');
      if (ca) {
        navigator.clipboard.writeText(ca).then(() => {
          const original = copyBtn.textContent;
          copyBtn.textContent = 'Copied! ✓';
          copyBtn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            copyBtn.textContent = original;
            copyBtn.classList.remove('bg-emerald-600', 'text-white');
          }, 2000);
        });
      }
    });
  }
</script>
