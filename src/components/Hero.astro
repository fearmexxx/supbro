---
import { TOKEN_CONFIG } from '../data/brothers';
---

<section id="dos-prompt" class="max-w-7xl mx-auto px-4 py-8">
  
  <!-- IBM / MS-DOS System Boot Window -->
  <div class="dos-box p-4 sm:p-6 text-[#ffffff] font-dos text-xl sm:text-2xl leading-snug">
    
    <!-- BIOS Header -->
    <div class="border-b-2 border-[#55ffff] pb-3 mb-4 text-[#55ffff]">
      <div>BROTHER-BIOS (C) 2024-2026 STARKNET MEME CORP. ALL RIGHTS RESERVED.</div>
      <div class="text-[#aaaaaa] text-lg">REVOLUTION PROTOCOL: HARDSHIP TO ETERNAL GLORY // CAIRO v2.8.4 KERNEL</div>
      <div class="text-[#ffff55] text-lg">MEMORY CHECK: 640KB BASE OK // 1,000,000,000,000,000 $BROTHER EXTENDED OK</div>
    </div>

    <!-- Hardship to Revolution Narrative in ASCII Box -->
    <div class="bg-[#000080] border border-[#ffffff] p-4 my-4 text-[#ffffff] text-lg sm:text-xl font-mono-code leading-relaxed">
      <div class="text-[#ffff55] font-bold mb-2">
        *** SYSTEM TRANSMISSION: THE BROTHER REVOLUTION ***
      </div>
      <p class="mb-2 text-[#55ffff]">
        [YEAR 2024] - THE HARD TIMES:
        In the depths of surveillance capitalism and brutal crypto winters, brothers held with zero cabal support, sleepless trading nights, and pure unwavering diamond hands.
      </p>
      <p class="text-[#55ff55]">
        [CURRENT ERA] - THE STARKNET REVOLUTION:
        Today, Starknet leads the world with STARK zero-knowledge proofs. We built $BROTHER not as a short-lived joke, but as a permanent digital brotherhood with 100% locked liquidity on unruggable.meme.
      </p>
    </div>

    <!-- Interactive Command Line Shell -->
    <div class="mt-6 bg-[#000000] border-2 border-[#55ffff] p-4 text-[#55ff55] font-mono-code text-sm sm:text-base">
      <div class="text-[#aaaaaa] text-xs mb-3">
        Type <span class="text-[#ffff55]">HELP</span>, <span class="text-[#ffff55]">DIR</span>, <span class="text-[#ffff55]">MANIFESTO</span>, <span class="text-[#ffff55]">BUY</span>, <span class="text-[#ffff55]">ROSTER</span>, <span class="text-[#ffff55]">CONTRACT</span>, or <span class="text-[#ffff55]">CLS</span>
      </div>

      <!-- Output log -->
      <div id="cli-output" class="space-y-1 mb-3">
        <div>C:\BROTHER&gt; SYSTEM BOOT READY. STARKNET REVOLUTION ENGINE LOADED.</div>
        <div class="text-[#ffff55]">C:\BROTHER&gt; TYPE 'DIR' TO BROWSE REVOLUTION FILES OR USE THE BUTTONS BELOW.</div>
      </div>

      <!-- Command Input line -->
      <div class="flex items-center gap-2">
        <span class="text-[#55ffff] font-bold shrink-0">C:\BROTHER&gt;</span>
        <input 
          type="text" 
          id="cli-input"
          class="w-full bg-transparent text-[#ffff55] focus:outline-none font-mono-code text-sm sm:text-base uppercase"
          placeholder="TYPE COMMAND HERE..."
          autocomplete="off"
          autofocus
        />
        <span class="dos-cursor"></span>
      </div>
    </div>

    <!-- Quick Tool Bar / Floppy Action Buttons -->
    <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3">
      <button 
        type="button" 
        data-cmd="BUY"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">💾</span>
        <span>BUY_AVNU.SYS</span>
      </button>

      <button 
        type="button" 
        data-cmd="MANIFESTO"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">📄</span>
        <span>MANIFESTO.TXT</span>
      </button>

      <button 
        type="button" 
        data-cmd="ROSTER"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">👥</span>
        <span>ROSTER.EXE</span>
      </button>

      <button 
        type="button" 
        data-cmd="MEME"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">🎨</span>
        <span>PAINT_MEME.EXE</span>
      </button>

      <button 
        type="button" 
        data-cmd="GECKO"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">🦎</span>
        <span>GECKOTERM.COM</span>
      </button>

      <button 
        type="button" 
        data-cmd="CONTRACT"
        class="quick-cmd-btn win31-btn p-2.5 text-center font-bold font-mono-code text-xs sm:text-sm flex flex-col items-center gap-1 cursor-pointer"
      >
        <span class="text-xl">📋</span>
        <span>COPY_CA.BAT</span>
      </button>
    </div>

  </div>

</section>

<script>
  // MS-DOS CLI Logic
  const cliInput = document.getElementById('cli-input') as HTMLInputElement;
  const cliOutput = document.getElementById('cli-output');
  const quickBtns = document.querySelectorAll('.quick-cmd-btn');

  const contractAddress = "0x03b405a98c9e795d427fe82cdeeeed803f221b52471e3a757574a2b4180793ee";

  function printLine(text: string, colorClass = "text-[#ffffff]") {
    if (!cliOutput) return;
    const div = document.createElement('div');
    div.className = colorClass;
    div.innerHTML = text;
    cliOutput.appendChild(div);
    cliOutput.scrollTop = cliOutput.scrollHeight;
  }

  function handleCommand(cmdRaw: string) {
    const cmd = cmdRaw.trim().toUpperCase();
    if (!cmd) return;

    printLine(`C:\\BROTHER&gt; ${cmd}`, "text-[#ffff55]");

    switch (cmd) {
      case 'HELP':
        printLine(`AVAILABLE COMMANDS:`, "text-[#55ffff]");
        printLine(`  DIR           - List directory files and programs`);
        printLine(`  MANIFESTO     - Open sacred brother lore & tenets`);
        printLine(`  ROSTER        - View Brothers Hall of Fame`);
        printLine(`  BUY           - Open Avnu Swap interface`);
        printLine(`  CHART / GECKO - Open DexScreener & GeckoTerminal`);
        printLine(`  MEME / PAINT  - Launch 8-bit Meme & PFP Creator`);
        printLine(`  CONTRACT      - Copy $BROTHER contract address`);
        printLine(`  HARDSHIP      - Read the revolution back-story`);
        printLine(`  CLS           - Clear terminal buffer`);
        break;

      case 'DIR':
        printLine(` Volume in drive C is BROTHER_REVOLUTION`);
        printLine(` Directory of C:\\BROTHER`, "text-[#55ffff]");
        printLine(` MANIFESTO.TXT     2,024  10-31-24  Sacred Creed`);
        printLine(` ROSTER.EXE       18,000  10-31-24  Core Brothers`);
        printLine(` BUY_AVNU.SYS      4,321  10-31-24  DEX Protocol`);
        printLine(` PAINT_MEME.EXE   64,000  10-31-24  Creation Lab`);
        printLine(` GECKOTERM.COM     1,337  10-31-24  Live Pool`);
        printLine(` CONTRACT.TXT         66  10-31-24  Starknet Address`);
        printLine(` HARDSHIP.LOG        640  10-31-24  Historical Struggle`);
        printLine(`       7 File(s)    90,488 bytes`);
        printLine(`       1 Dir(s)  1,000,000,000,000,000 bytes free`, "text-[#55ff55]");
        break;

      case 'MANIFESTO':
        printLine(`LOADING MANIFESTO.TXT INTO MEMORY...`, "text-[#55ffff]");
        const manEl = document.getElementById('manifesto');
        if (manEl) manEl.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'ROSTER':
      case 'HALL OF FAME':
        printLine(`EXECUTING ROSTER.EXE (7 CORE BROTHERS)...`, "text-[#55ffff]");
        const hofEl = document.getElementById('hall-of-fame');
        if (hofEl) hofEl.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'MEME':
      case 'PAINT':
        printLine(`INITIALIZING PAINT_MEME.EXE...`, "text-[#55ffff]");
        const memeEl = document.getElementById('meme-maker');
        if (memeEl) memeEl.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'BUY':
        printLine(`CONNECTING TO AVNU DEX ROUTER...`, "text-[#55ff55]");
        window.open('https://app.avnu.fi/en?amount=0.1&tokenFrom=0x4718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d&tokenTo=0x3b405a98c9e795d427fe82cdeeeed803f221b52471e3a757574a2b4180793ee', '_blank');
        break;

      case 'GECKO':
      case 'CHART':
        printLine(`OPENING GECKOTERMINAL ALPHA POOL...`, "text-[#55ff55]");
        window.open('https://www.geckoterminal.com/starknet-alpha/pools/0x00d4cf27867a524d5da0eb8a9d570506c9db85ee8fce7a90e4c5f8488251360a', '_blank');
        break;

      case 'CONTRACT':
      case 'CA':
        navigator.clipboard.writeText(contractAddress);
        printLine(`[SUCCESS] CONTRACT ADDRESS COPIED TO CLIPBOARD:`, "text-[#55ff55]");
        printLine(`&gt;&gt; ${contractAddress}`, "text-[#ffff55]");
        break;

      case 'HARDSHIP':
        printLine(`[ARCHIVE LOG: BROTHER HARDSHIP]`, "text-[#55ffff]");
        printLine(`We endured the era of zero liquidity, predatory VCs, and bear fatigue.`);
        printLine(`Brothers banded together on Starknet. No cabal. Just conviction.`);
        printLine(`The revolution has arrived: BROTHERCYCLE (REAL).`, "text-[#ffff55]");
        break;

      case 'CLS':
      case 'CLEAR':
        if (cliOutput) cliOutput.innerHTML = '';
        printLine(`C:\\BROTHER&gt; SCREEN BUFFER CLEARED.`);
        break;

      default:
        printLine(`Bad command or file name: "${cmd}". Type HELP for command list.`, "text-[#ff5555]");
        break;
    }
  }

  cliInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const val = cliInput.value;
      cliInput.value = '';
      handleCommand(val);
    }
  });

  quickBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-cmd');
      if (cmd) handleCommand(cmd);
    });
  });
</script>
