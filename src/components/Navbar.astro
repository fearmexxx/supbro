---
import { TOKEN_CONFIG } from '../data/brothers';
---

<!-- MS-DOS / WIN 3.1 SYSTEM HEADER BAR -->
<header class="sticky top-0 z-50 bg-[#000080] border-b-2 border-[#ffffff] text-white font-dos text-xl select-none shadow-md">
  <div class="max-w-7xl mx-auto px-3 py-1 flex items-center justify-between flex-wrap gap-2">
    
    <!-- Left: OS Title & Status -->
    <div class="flex items-center gap-3">
      <span class="bg-[#c0c0c0] text-[#000000] px-2 py-0.5 font-bold text-base border border-[#ffffff]">
        [≡]
      </span>
      <span class="text-[#ffff55] tracking-wider text-2xl font-bold">
        BROTHER-DOS v3.1
      </span>
      <span class="hidden sm:inline-block bg-[#0000aa] text-[#55ffff] px-2 py-0.5 text-base border border-[#55ffff]">
        BASE MEM: 640KB OK
      </span>
      <span class="hidden md:inline-block text-[#55ff55] text-base">
        [STARKNET_MAINNET.SYS ACTIVE]
      </span>
    </div>

    <!-- Quick Function Key Shortcuts (DOS Navigation) -->
    <nav class="flex items-center gap-2 overflow-x-auto text-sm sm:text-base font-mono-code py-1">
      <a href="#dos-prompt" class="px-2 py-0.5 bg-[#c0c0c0] text-[#000000] hover:bg-[#ffffff] font-bold border-t border-l border-white border-b-2 border-r-2 border-black">
        F1:PROMPT
      </a>
      <a href="#manifesto" class="px-2 py-0.5 bg-[#c0c0c0] text-[#000000] hover:bg-[#ffffff] font-bold border-t border-l border-white border-b-2 border-r-2 border-black">
        F2:MANIFESTO
      </a>
      <a href="#hall-of-fame" class="px-2 py-0.5 bg-[#c0c0c0] text-[#000000] hover:bg-[#ffffff] font-bold border-t border-l border-white border-b-2 border-r-2 border-black">
        F3:ROSTER
      </a>
      <a href="#meme-maker" class="px-2 py-0.5 bg-[#c0c0c0] text-[#000000] hover:bg-[#ffffff] font-bold border-t border-l border-white border-b-2 border-r-2 border-black">
        F4:PAINT.EXE
      </a>
      <a href={TOKEN_CONFIG.avnuBuyUrl} target="_blank" class="px-2 py-0.5 bg-[#55ff55] text-[#000000] hover:bg-[#ffffff] font-bold border-t border-l border-white border-b-2 border-r-2 border-black">
        F5:BUY_AVNU
      </a>
    </nav>

    <!-- CRT Filter & Wallet Toggle -->
    <div class="flex items-center gap-2">
      <button 
        id="toggle-crt-btn"
        class="px-2 py-0.5 bg-[#0000aa] text-[#ffff55] border border-[#ffff55] hover:bg-[#ffff55] hover:text-[#000000] text-xs font-mono-code cursor-pointer"
        title="Toggle CRT Scanline Effect"
      >
        [CRT: ON]
      </button>

      <button 
        id="wallet-connect-btn"
        class="px-2.5 py-0.5 bg-[#c0c0c0] text-[#000000] border-t-2 border-l-2 border-white border-b-2 border-r-2 border-black font-bold text-xs font-mono-code active:translate-x-0.5 active:translate-y-0.5 cursor-pointer"
      >
        <span id="wallet-btn-label">CONNECT_WALLET.SYS</span>
      </button>
    </div>

  </div>
</header>

<script>
  // Toggle CRT Scanlines
  const crtBtn = document.getElementById('toggle-crt-btn');
  crtBtn?.addEventListener('click', () => {
    const isScanline = document.body.classList.toggle('crt-scanlines');
    document.body.classList.toggle('crt-flicker');
    crtBtn.textContent = isScanline ? '[CRT: ON]' : '[CRT: OFF]';
  });
</script>
