---
import { TOKEN_CONFIG } from '../data/brothers';
---

<section id="stats" class="max-w-7xl mx-auto px-4 py-8">
  
  <!-- Windows 3.1 Styled Performance & Metrics Window -->
  <div class="win31-window">
    
    <!-- Titlebar -->
    <div class="win31-titlebar flex items-center justify-between font-mono-code text-sm">
      <div class="flex items-center gap-2">
        <span class="bg-[#c0c0c0] text-[#000000] px-1.5 border border-white text-xs">▼</span>
        <span>STARKNET_DEX_MONITOR.EXE - [ON-CHAIN TELEMETRY]</span>
      </div>
      <div class="flex items-center gap-1">
        <button class="bg-[#c0c0c0] text-[#000000] px-2 py-0.5 border border-white text-xs font-bold">▲</button>
        <button class="bg-[#c0c0c0] text-[#000000] px-2 py-0.5 border border-white text-xs font-bold">■</button>
      </div>
    </div>

    <!-- Window Menu Bar -->
    <div class="bg-[#c0c0c0] border-b border-[#808080] px-3 py-1 flex items-center gap-4 text-xs font-mono-code text-black select-none">
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>F</u>ile</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>E</u>dit</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>S</u>tats</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>P</u>ools</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>H</u>elp</span>
    </div>

    <!-- Window Content Area (DOS Blue Inner Screen) -->
    <div class="p-4 sm:p-6 bg-[#0000aa] text-white font-mono-code">
      
      <!-- Top Status Banner -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-[#55ffff] pb-3 mb-6 gap-2">
        <div>
          <div class="text-[#ffff55] font-bold text-base sm:text-lg">
            STARKNET ALPHA MAINNET TELEMETRY [PORT: 4321]
          </div>
          <div class="text-xs text-[#55ffff]">
            PAIR: $BROTHER / STRK // POOL: 0x00d4cf27867...360a
          </div>
        </div>
        
        <div class="flex items-center gap-2">
          <a 
            href={TOKEN_CONFIG.geckoTerminalUrl} 
            target="_blank" 
            class="win31-btn px-3 py-1 text-xs font-bold text-black hover:bg-white flex items-center gap-1 cursor-pointer"
          >
            <span>🦎 GeckoTerminal Pool</span>
            <span>↗</span>
          </a>
          <a 
            href={TOKEN_CONFIG.dexScreenerUrl} 
            target="_blank" 
            class="win31-btn px-3 py-1 text-xs font-bold text-black hover:bg-white flex items-center gap-1 cursor-pointer"
          >
            <span>📈 DexScreener</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- 6 Metrics Retro Cards -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
        
        <!-- Metric 1: Price -->
        <div class="bg-[#000080] border-2 border-white p-3 text-center">
          <div class="text-[10px] text-[#55ffff] font-bold">TOKEN PRICE</div>
          <div class="text-sm sm:text-base font-bold text-[#ffff55] my-1" id="ticker-price">
            Loading...
          </div>
          <div class="text-[10px] text-[#55ff55] font-bold" id="ticker-change">+0.00% 24H</div>
        </div>

        <!-- Metric 2: Volume -->
        <div class="bg-[#000080] border-2 border-white p-3 text-center">
          <div class="text-[10px] text-[#55ffff] font-bold">24H VOLUME</div>
          <div class="text-sm sm:text-base font-bold text-white my-1" id="ticker-volume">
            $17.8K+
          </div>
          <div class="text-[10px] text-[#aaaaaa]">ON-CHAIN SWAPS</div>
        </div>

        <!-- Metric 3: Liquidity -->
        <div class="bg-[#000080] border-2 border-white p-3 text-center">
          <div class="text-[10px] text-[#55ffff] font-bold">DEX LIQUIDITY</div>
          <div class="text-sm sm:text-base font-bold text-[#55ff55] my-1" id="ticker-liquidity">
            $100.8K+
          </div>
          <div class="text-[10px] text-[#aaaaaa]">DEEP ALPHA POOL</div>
        </div>

        <!-- Metric 4: Market Cap -->
        <div class="bg-[#000080] border-2 border-white p-3 text-center">
          <div class="text-[10px] text-[#55ffff] font-bold">MARKET CAP / FDV</div>
          <div class="text-sm sm:text-base font-bold text-white my-1" id="ticker-mcap">
            $561.4K
          </div>
          <div class="text-[10px] text-[#55ffff]">FULLY DILUTED</div>
        </div>

        <!-- Metric 5: Total Supply -->
        <div class="bg-[#000080] border-2 border-white p-3 text-center">
          <div class="text-[10px] text-[#55ffff] font-bold">TOTAL SUPPLY</div>
          <div class="text-sm sm:text-base font-bold text-white my-1">
            1,000T
          </div>
          <div class="text-[10px] text-[#aaaaaa]">FIXED QUADRILLION</div>
        </div>

        <!-- Metric 6: Security Lock -->
        <div class="bg-[#000080] border-2 border-white p-3 text-center">
          <div class="text-[10px] text-[#55ffff] font-bold">SAFETY INTEGRITY</div>
          <div class="text-sm sm:text-base font-bold text-[#55ff55] my-1">
            🔒 100% LOCKED
          </div>
          <div class="text-[10px] text-[#ffff55]">UNRUGGABLE.MEME</div>
        </div>

      </div>

      <!-- Contract Address Tape -->
      <div class="bg-[#000000] border border-[#55ffff] p-3 flex flex-col md:flex-row items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="text-[#ffff55] font-bold">[CONTRACT_ADDR]:</span>
          <span class="text-white select-all break-all font-mono-code">{TOKEN_CONFIG.contractAddress}</span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button 
            id="copy-ca-dos-btn" 
            data-ca={TOKEN_CONFIG.contractAddress}
            class="win31-btn px-3 py-1 font-bold text-black hover:bg-white cursor-pointer"
          >
            COPY_CA.BAT
          </button>
          <a 
            href={TOKEN_CONFIG.starkscanUrl} 
            target="_blank" 
            class="win31-btn px-3 py-1 font-bold text-black hover:bg-white cursor-pointer"
          >
            STARKSCAN.EXE ↗
          </a>
        </div>
      </div>

    </div>

    <!-- Window Status Bar -->
    <div class="bg-[#c0c0c0] border-t border-[#ffffff] px-3 py-1 flex items-center justify-between text-xs font-mono-code text-black select-none">
      <span>Status: 100% UNRUGGABLE // MATHEMATICALLY PROVEN</span>
      <span>BLOCKCHAIN: STARKNET</span>
    </div>

  </div>

</section>

<script>
  // DexScreener live API telemetry
  async function fetchDexData() {
    try {
      const pairAddress = "0x03b405a98c9e795d427fe82cdeeeed803f221b52471e3a757574a2b4180793ee";
      const res = await fetch(`https://api.dexscreener.com/latest/dex/tokens/${pairAddress}`);
      if (!res.ok) return;
      const data = await res.json();
      if (data.pairs && data.pairs.length > 0) {
        const pair = data.pairs[0];
        const priceEl = document.getElementById('ticker-price');
        const changeEl = document.getElementById('ticker-change');
        const mcapEl = document.getElementById('ticker-mcap');
        const volEl = document.getElementById('ticker-volume');
        const liqEl = document.getElementById('ticker-liquidity');

        if (priceEl && pair.priceUsd) {
          const price = parseFloat(pair.priceUsd);
          priceEl.textContent = `$${price < 0.000001 ? price.toExponential(4) : price.toFixed(8)}`;
        }
        if (changeEl && pair.priceChange && pair.priceChange.h24 !== undefined) {
          const ch = pair.priceChange.h24;
          changeEl.textContent = `${ch >= 0 ? '+' : ''}${ch}% 24H`;
          changeEl.className = `text-[10px] font-bold font-mono-code ${ch >= 0 ? 'text-[#55ff55]' : 'text-[#ff5555]'}`;
        }
        if (mcapEl && (pair.marketCap || pair.fdv)) {
          const mcap = pair.marketCap || pair.fdv;
          mcapEl.textContent = `$${(mcap / 1000).toFixed(1)}K`;
        }
        if (volEl && pair.volume && pair.volume.h24) {
          volEl.textContent = `$${(pair.volume.h24 / 1000).toFixed(1)}K`;
        }
        if (liqEl && pair.liquidity && pair.liquidity.usd) {
          liqEl.textContent = `$${(pair.liquidity.usd / 1000).toFixed(1)}K`;
        }
      }
    } catch (e) {
      console.log('Telemetry fetch fallback:', e);
    }
  }

  fetchDexData();
  setInterval(fetchDexData, 20000);

  const copyBtn = document.getElementById('copy-ca-dos-btn');
  copyBtn?.addEventListener('click', () => {
    const ca = copyBtn.getAttribute('data-ca');
    if (ca) {
      navigator.clipboard.writeText(ca).then(() => {
        const orig = copyBtn.textContent;
        copyBtn.textContent = 'COPIED! ✓';
        setTimeout(() => copyBtn.textContent = orig, 2000);
      });
    }
  });
</script>
