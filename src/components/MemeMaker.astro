---
import { BROTHERS_LIST } from '../data/brothers';
---

<section id="meme-maker" class="max-w-7xl mx-auto px-4 py-8">
  
  <!-- Windows 3.1 MS Paint Styled Window -->
  <div class="win31-window">
    
    <!-- Titlebar -->
    <div class="win31-titlebar flex items-center justify-between font-mono-code text-sm">
      <div class="flex items-center gap-2">
        <span class="bg-[#c0c0c0] text-[#000000] px-1.5 border border-white text-xs">▼</span>
        <span>BROTHER_PAINT.EXE - [REVOLUTION MEME LAB v3.1]</span>
      </div>
      <div class="flex items-center gap-1">
        <button class="bg-[#c0c0c0] text-[#000000] px-2 py-0.5 border border-white text-xs font-bold">▲</button>
        <button class="bg-[#c0c0c0] text-[#000000] px-2 py-0.5 border border-white text-xs font-bold">■</button>
      </div>
    </div>

    <!-- Paint Menu Bar -->
    <div class="bg-[#c0c0c0] border-b border-[#808080] px-3 py-1 flex items-center gap-4 text-xs font-mono-code text-black select-none">
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>F</u>ile</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>E</u>dit</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>V</u>iew</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>T</u>ext</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>P</u>alette</span>
      <span class="hover:bg-[#000080] hover:text-white px-1 cursor-pointer"><u>H</u>elp</span>
    </div>

    <!-- Paint Work Area -->
    <div class="p-4 sm:p-6 bg-[#808080] text-black font-mono-code">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Canvas Canvas Display -->
        <div class="lg:col-span-6 flex flex-col items-center">
          <div class="border-4 border-[#ffffff] border-r-[#404040] border-b-[#404040] bg-[#ffffff] p-2 shadow-inner">
            <canvas id="dos-canvas" width="600" height="600" class="w-full max-w-sm aspect-square bg-black border-2 border-black object-contain"></canvas>
          </div>

          <button 
            id="download-dos-meme-btn"
            class="mt-4 win31-btn px-6 py-2.5 font-bold text-sm text-black flex items-center gap-2 cursor-pointer shadow-md active:translate-x-0.5 active:translate-y-0.5"
          >
            <span>💾 SAVE_AS_BITMAP.BMP</span>
          </button>
        </div>

        <!-- Toolset & Captions Panel -->
        <div class="lg:col-span-6 space-y-4">
          
          <!-- Palette 1: Pick Base Brother -->
          <div class="win31-window p-3">
            <div class="text-xs font-bold text-black uppercase mb-2 border-b border-gray-400 pb-1">
              1. SELECT 8-BIT BASE ASSET:
            </div>
            <div class="flex gap-2 overflow-x-auto pb-1">
              {BROTHERS_LIST.map((bro) => (
                <button 
                  type="button"
                  data-img={`/brothers/${bro.id}.jpeg`}
                  class="paint-base-btn border-2 border-black p-0.5 bg-white shrink-0 w-12 h-12 cursor-pointer hover:border-[#000080]"
                  title={bro.name}
                >
                  <img src={`/brothers/${bro.id}.jpeg`} alt={bro.name} class="w-full h-full object-cover" onerror="this.src='/image/logo.jpeg'"/>
                </button>
              ))}
            </div>
          </div>

          <!-- Palette 2: Text Captions -->
          <div class="win31-window p-3 space-y-3">
            <div class="text-xs font-bold text-black uppercase border-b border-gray-400 pb-1">
              2. RETRO CAPTION OVERLAY:
            </div>
            <div>
              <label class="block text-[10px] text-gray-700 mb-1">TOP CAPTION:</label>
              <input 
                type="text" 
                id="dos-top-text" 
                value="BROTHERCYCLE (REAL)" 
                class="w-full bg-white border-2 border-black px-2 py-1 text-xs font-mono-code uppercase font-bold text-black focus:outline-none"
              />
            </div>
            <div>
              <label class="block text-[10px] text-gray-700 mb-1">BOTTOM CAPTION:</label>
              <input 
                type="text" 
                id="dos-bot-text" 
                value="FROM HARDSHIP TO GLORY" 
                class="w-full bg-white border-2 border-black px-2 py-1 text-xs font-mono-code uppercase font-bold text-black focus:outline-none"
              />
            </div>
          </div>

          <!-- Palette 3: Retro Badge Stamp -->
          <div class="win31-window p-3">
            <div class="text-xs font-bold text-black uppercase mb-2 border-b border-gray-400 pb-1">
              3. STAMP TOOL:
            </div>
            <div class="flex flex-wrap gap-2 text-xs">
              <button type="button" class="stamp-btn win31-btn px-2.5 py-1 font-bold" data-stamp="STARKNET_BRO">
                [🏷️ STARKNET_BRO]
              </button>
              <button type="button" class="stamp-btn win31-btn px-2.5 py-1 font-bold" data-stamp="HARDSHIP_SURVIVOR">
                [🛡️ HARDSHIP_VETERAN]
              </button>
              <button type="button" class="stamp-btn win31-btn px-2.5 py-1 font-bold" data-stamp="100%_UNRUGGABLE">
                [🔒 UNRUGGABLE]
              </button>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- Window Footer -->
    <div class="bg-[#c0c0c0] border-t border-[#ffffff] px-3 py-1 flex items-center justify-between text-xs font-mono-code text-black select-none">
      <span>TOOL: CAPTION BRUSH // COLOR: DOS HIGH INTENSITY</span>
      <span>READY FOR EXPORT</span>
    </div>

  </div>

</section>

<script>
  const canvas = document.getElementById('dos-canvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const topInput = document.getElementById('dos-top-text') as HTMLInputElement;
  const botInput = document.getElementById('dos-bot-text') as HTMLInputElement;
  const downloadBtn = document.getElementById('download-dos-meme-btn');
  const baseButtons = document.querySelectorAll('.paint-base-btn');
  const stampButtons = document.querySelectorAll('.stamp-btn');

  let currentImageSrc = '/brothers/MAXX.jpeg';
  let currentStamp = 'STARKNET_BRO';

  const baseImage = new Image();
  baseImage.crossOrigin = 'anonymous';
  baseImage.src = currentImageSrc;
  baseImage.onload = () => renderCanvas();

  function renderCanvas() {
    if (!canvas || !ctx) return;
    const w = canvas.width;
    const h = canvas.height;

    // Draw retro DOS blue / black background
    ctx.fillStyle = '#0000aa';
    ctx.fillRect(0, 0, w, h);

    // Draw main image
    if (baseImage.complete && baseImage.naturalHeight !== 0) {
      ctx.drawImage(baseImage, 0, 0, w, h);
    }

    // DOS Scanline effect on canvas
    ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
    for (let y = 0; y < h; y += 4) {
      ctx.fillRect(0, y, w, 2);
    }

    // Top & Bottom banner strips (retro text boxes)
    ctx.fillStyle = '#000080';
    ctx.fillRect(0, 0, w, 70);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 68, w, 3);

    ctx.fillStyle = '#000080';
    ctx.fillRect(0, h - 80, w, 80);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, h - 82, w, 3);

    // Typography
    ctx.font = 'bold 30px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillStyle = '#ffff55';

    const topText = topInput?.value || '';
    if (topText) {
      ctx.fillText(topText.toUpperCase(), w / 2, 46);
    }

    const botText = botInput?.value || '';
    if (botText) {
      ctx.fillStyle = '#55ffff';
      ctx.fillText(botText.toUpperCase(), w / 2, h - 35);
    }

    // Stamp badge in corner
    if (currentStamp) {
      ctx.fillStyle = '#000000';
      ctx.fillRect(20, h - 120, 240, 30);
      ctx.strokeStyle = '#55ff55';
      ctx.strokeRect(20, h - 120, 240, 30);
      ctx.font = 'bold 15px monospace';
      ctx.fillStyle = '#55ff55';
      ctx.textAlign = 'center';
      ctx.fillText(`[${currentStamp}]`, 140, h - 100);
    }
  }

  topInput?.addEventListener('input', renderCanvas);
  botInput?.addEventListener('input', renderCanvas);

  baseButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-img');
      if (src) {
        currentImageSrc = src;
        baseImage.src = src;
      }
    });
  });

  stampButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      currentStamp = btn.getAttribute('data-stamp') || '';
      renderCanvas();
    });
  });

  downloadBtn?.addEventListener('click', () => {
    if (!canvas) return;
    const link = document.createElement('a');
    link.download = `starknet-brother-dos-${Date.now()}.png`;
    link.href = canvas.toDataURL('image/png');
    link.click();
  });
</script>
