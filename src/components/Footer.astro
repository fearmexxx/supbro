---
import { TOKEN_CONFIG } from '../data/brothers';
---

<footer class="mt-24 border-t border-slate-800/80 bg-[#070b16] py-16 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Col 1: Identity & Creed -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl overflow-hidden ring-1 ring-blue-500/40">
            <img src="/image/logo.jpeg" alt="Starknet Brother" class="w-full h-full object-cover" onerror="this.src='/favicon.png'"/>
          </div>
          <span class="font-display font-bold text-lg text-white">STARKNET BROTHER</span>
        </div>
        <p class="text-sm text-slate-400 max-w-md leading-relaxed">
          The leading cultural meme token on Starknet. Built by brothers, powered by mathematics and memes. In brotherhood, we find strength. In creation, we find purpose.
        </p>
        <div class="font-mono text-xs text-blue-400/90 pt-1">
          "BROTHERCYCLE (REAL) • DECADES NOT DAYS"
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h3 class="text-xs font-mono uppercase tracking-wider text-slate-200 font-semibold">Explore</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-blue-400 transition-colors">Home Hub</a></li>
          <li><a href="/manifesto" class="hover:text-blue-400 transition-colors">The Brother Manifesto</a></li>
          <li><a href="#hall-of-fame" class="hover:text-blue-400 transition-colors">Brothers Hall of Fame</a></li>
          <li><a href="#meme-maker" class="hover:text-blue-400 transition-colors">Brother Meme Lab</a></li>
          <li><a href={TOKEN_CONFIG.idPortalUrl} target="_blank" class="hover:text-blue-400 transition-colors">Brother ID Portal ↗</a></li>
        </ul>
      </div>

      <!-- Col 3: Starknet Ecosystem Links -->
      <div class="space-y-3">
        <h3 class="text-xs font-mono uppercase tracking-wider text-slate-200 font-semibold">Starknet Ecosystem</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={TOKEN_CONFIG.avnuBuyUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">Trade on AVNU</a></li>
          <li><a href={TOKEN_CONFIG.dexScreenerUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">DexScreener Chart</a></li>
          <li><a href={TOKEN_CONFIG.geckoTerminalUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">GeckoTerminal Pool</a></li>
          <li><a href={TOKEN_CONFIG.starkscanUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">Starkscan Contract</a></li>
          <li><a href={TOKEN_CONFIG.platformUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">Unruggable.meme Launch</a></li>
          <li><a href={TOKEN_CONFIG.twitterUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">Twitter (@StarknetBro)</a></li>
          <li><a href={TOKEN_CONFIG.telegramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">Telegram Community</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 font-mono">
      <div>
        © 2024–2026 Starknet Brother ($BROTHER). Open culture, zero hate.
      </div>
      <div class="flex items-center gap-6">
        <span>Cairo Powered</span>
        <span>•</span>
        <span>Fair Launch</span>
        <span>•</span>
        <span>Locked Liquidity</span>
      </div>
    </div>
  </div>
</footer>
