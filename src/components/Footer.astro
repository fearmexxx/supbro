---
import { TOKEN_CONFIG } from '../data/brothers';
---

<footer class="mt-20 border-t-2 border-[#55ffff] bg-[#000080] text-white py-12 font-mono-code text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Col 1 -->
      <div class="md:col-span-2 space-y-3">
        <div class="text-[#ffff55] font-bold text-base flex items-center gap-2">
          <span>💾</span>
          <span>BROTHER-DOS v3.1 // STARKNET REVOLUTION</span>
        </div>
        <p class="text-[#aaaaaa] leading-relaxed">
          From the cold hardship of crypto winter to the cutting-edge of zero-knowledge scaling. 
          Mathematical proofs, unruggable liquidity, and sovereign brotherhood.
        </p>
        <div class="text-[#55ff55]">
          "BROTHERCYCLE (REAL): WE BUILD FOR DECADES, NOT DAYS."
        </div>
      </div>

      <!-- Col 2: System Programs -->
      <div class="space-y-2">
        <div class="text-[#55ffff] font-bold uppercase border-b border-[#55ffff] pb-1">PROGRAMS</div>
        <ul class="space-y-1 text-[#aaaaaa]">
          <li><a href="#dos-prompt" class="hover:text-white">C:\PROMPT.COM</a></li>
          <li><a href="/manifesto" class="hover:text-white">C:\MANIFESTO.DOC</a></li>
          <li><a href="#hall-of-fame" class="hover:text-white">C:\ROSTER.EXE</a></li>
          <li><a href="#meme-maker" class="hover:text-white">C:\PAINT.EXE</a></li>
          <li><a href={TOKEN_CONFIG.idPortalUrl} target="_blank" class="hover:text-white">C:\BROTHER_ID.SYS ↗</a></li>
        </ul>
      </div>

      <!-- Col 3: On-Chain Endpoints -->
      <div class="space-y-2">
        <div class="text-[#55ffff] font-bold uppercase border-b border-[#55ffff] pb-1">ENDPOINTS</div>
        <ul class="space-y-1 text-[#aaaaaa]">
          <li><a href={TOKEN_CONFIG.avnuBuyUrl} target="_blank" class="hover:text-[#55ff55]">DEX: AVNU_SWAP.COM ↗</a></li>
          <li><a href={TOKEN_CONFIG.dexScreenerUrl} target="_blank" class="hover:text-[#55ff55]">CHART: DEXSCREENER.EXE ↗</a></li>
          <li><a href={TOKEN_CONFIG.geckoTerminalUrl} target="_blank" class="hover:text-[#55ff55]">POOL: GECKOTERMINAL.COM ↗</a></li>
          <li><a href={TOKEN_CONFIG.starkscanUrl} target="_blank" class="hover:text-[#55ff55]">SCAN: STARKSCAN.NET ↗</a></li>
          <li><a href={TOKEN_CONFIG.twitterUrl} target="_blank" class="hover:text-[#55ff55]">COMMS: X_TWITTER.SYS ↗</a></li>
          <li><a href={TOKEN_CONFIG.telegramUrl} target="_blank" class="hover:text-[#55ff55]">CHAT: TELEGRAM.BAT ↗</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom DOS Status Bar -->
    <div class="pt-4 border-t border-[#aaaaaa] flex flex-col sm:flex-row items-center justify-between gap-2 text-[#aaaaaa]">
      <div>
        (C) 2024-2026 STARKNET BROTHER CORP. // LICENSED UNDER CAIRO PROOFS.
      </div>
      <div class="text-[#ffff55]">
        640KB BASE MEMORY // 0KB CONVENTIONAL MEMORY LEAK
      </div>
    </div>

  </div>
</footer>
