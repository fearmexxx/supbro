---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TokenStats from '../components/TokenStats.astro';
import HallOfFame from '../components/HallOfFame.astro';
import MemeMaker from '../components/MemeMaker.astro';
import Footer from '../components/Footer.astro';
import { TOKEN_CONFIG } from '../data/brothers';
---

<Layout>
  <!-- MS-DOS / WIN 3.1 System Header -->
  <Navbar />

  <main class="space-y-6">
    <!-- 1. Hero Section: IBM BIOS Boot & MS-DOS Interactive Shell -->
    <Hero />

    <!-- 2. Windows 3.1 Live DEX Monitor -->
    <TokenStats />

    <!-- 3. Windows 3.1 Hall of Fame Dossier -->
    <HallOfFame />

    <!-- 4. Windows 3.1 MS Paint Meme Lab -->
    <MemeMaker />

    <!-- 5. Historical Hardship Archive & Manifesto Teaser Window -->
    <section id="manifesto-teaser" class="max-w-7xl mx-auto px-4 py-6">
      <div class="dos-box p-6 font-mono-code text-white">
        <div class="border-b-2 border-[#ffff55] pb-2 mb-4 flex items-center justify-between">
          <span class="text-[#ffff55] font-bold text-lg sm:text-xl font-dos">
            C:\ARCHIVE\HARDSHIP_TO_REVOLUTION.DOC
          </span>
          <span class="text-xs text-[#55ffff]">
            STATUS: PERMANENT LORE
          </span>
        </div>

        <p class="text-sm sm:text-base text-[#55ffff] mb-4 leading-relaxed">
          "A BROTHER ALONE IS STRONG. BROTHERS TOGETHER ARE UNSTOPPABLE."
          In an age of surveillance capitalism, declining social bonds, and tech disruption, brotherhood offers something greater: genuine human conviction and the power to selectively reveal ourselves to the world.
        </p>

        <div class="flex flex-wrap gap-3">
          <a 
            href="/manifesto" 
            class="win31-btn px-4 py-2 font-bold text-xs text-black bg-[#ffffff] hover:bg-[#55ffff] cursor-pointer"
          >
            EXECUTE EDIT_MANIFESTO.EXE ↗
          </a>
          <a 
            href={TOKEN_CONFIG.avnuBuyUrl} 
            target="_blank" 
            class="win31-btn px-4 py-2 font-bold text-xs text-black bg-[#55ff55] hover:bg-[#ffffff] cursor-pointer"
          >
            TRADE $BROTHER ON AVNU ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Retro System Footer -->
  <Footer />

  <!-- Global Starknet Wallet Connector Modal/Script -->
  <script>
    const walletBtn = document.getElementById('wallet-connect-btn');
    const walletLabel = document.getElementById('wallet-btn-label');

    let isConnected = false;

    if (walletBtn) {
      walletBtn.addEventListener('click', async () => {
        if (!isConnected) {
          const starknet = (window as any).starknet || (window as any).starknet_argentX || (window as any).starknet_braavos;
          if (starknet && starknet.enable) {
            try {
              walletLabel!.textContent = 'LOADING_DRIVER...';
              await starknet.enable();
              const account = starknet.selectedAddress;
              if (account) {
                isConnected = true;
                walletLabel!.textContent = `${account.slice(0, 6)}...${account.slice(-4)}.DRV`;
                return;
              }
            } catch (err) {
              console.log('Wallet error:', err);
            }
          }

          const confirmed = confirm("[STARKNET DRIVER INITIALIZE]\n\nLoad Argent X / Braavos driver to inspect $BROTHER balance?\n\n(Click OK to load simulated session)");
          if (confirmed) {
            isConnected = true;
            walletLabel!.textContent = "0x04b8...89fe.SYS";
            alert("SUCCESS: DRIVER LOADED // RANK: CORE BROTHER // BALANCE: 142M $BROTHER // STATUS: 100% UNRUGGABLE");
          } else {
            walletLabel!.textContent = "CONNECT_WALLET.SYS";
          }
        } else {
          isConnected = false;
          walletLabel!.textContent = "CONNECT_WALLET.SYS";
        }
      });
    }
  </script>
</Layout>
