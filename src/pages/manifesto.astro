---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { TOKEN_CONFIG } from '../data/brothers';
---

<Layout 
  title="C:\MANIFESTO.DOC - MS-DOS EDIT 2.0 [SACRED BROTHER LORE]"
  description="MS-DOS Edit 2.0 representation of the Sacred Brother Manifesto. The vision of brotherhood transcending hardships."
>
  <Navbar />

  <main class="max-w-5xl mx-auto px-4 py-8">
    
    <!-- MS-DOS EDIT v2.0 Window -->
    <div class="dos-box p-4 sm:p-8 text-white font-mono-code">
      
      <!-- DOS Edit Menu Header -->
      <div class="bg-[#c0c0c0] text-black px-3 py-1 flex items-center justify-between font-bold text-xs select-none mb-6 border-b border-black">
        <div class="flex items-center gap-4">
          <span class="hover:bg-[#000080] hover:text-white px-1"><u>F</u>ile</span>
          <span class="hover:bg-[#000080] hover:text-white px-1"><u>E</u>dit</span>
          <span class="hover:bg-[#000080] hover:text-white px-1"><u>S</u>earch</span>
          <span class="hover:bg-[#000080] hover:text-white px-1"><u>V</u>iew</span>
          <span class="hover:bg-[#000080] hover:text-white px-1"><u>O</u>ptions</span>
          <span class="hover:bg-[#000080] hover:text-white px-1"><u>H</u>elp</span>
        </div>
        <div class="text-[#000080]">
          EDIT.COM - [C:\MANIFESTO.DOC]
        </div>
      </div>

      <!-- Document Content in Classic DOS Navy Blue -->
      <div class="space-y-8 text-sm sm:text-base leading-relaxed">
        
        <!-- Header -->
        <div class="border-b-2 border-[#ffff55] pb-4 text-center">
          <div class="text-[#ffff55] text-2xl sm:text-3xl font-bold font-dos">
            ===========================================<br/>
            THE SACRED BROTHER MANIFESTO<br/>
            ===========================================
          </div>
          <div class="text-[#55ffff] font-bold text-lg mt-2">
            "BROTHERCYCLE (REAL)": THE HARDSHIP & THE REVOLUTION
          </div>
        </div>

        <!-- Vision -->
        <div class="bg-[#000080] border border-[#ffffff] p-4 text-[#ffffff]">
          <div class="text-[#ffff55] font-bold text-base mb-2">
            [SECTION 01: OUR HISTORIC VISION]
          </div>
          <p class="text-[#55ffff]">
            "In an age of surveillance capitalism, declining social bonds, and technological disruption, BROTHERHOOD offers something greater: genuine human connection, shared purpose, collective growth, and the power to selectively reveal ourselves to the world."
          </p>
        </div>

        <!-- Core Tenets -->
        <div>
          <div class="text-[#ffff55] font-bold text-lg mb-3">
            [SECTION 02: THE CORE TENETS OF BROTHERHOOD]
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm">
            
            <div class="bg-[#000080] border border-[#55ffff] p-3">
              <div class="text-[#55ff55] font-bold mb-1">1. TRANSCENDS ALL DIVIDES</div>
              <ul class="text-[#aaaaaa] space-y-1 list-disc pl-4">
                <li>Welcomes all who share our values</li>
                <li>No barriers of gender, race, or nation</li>
                <li>Zero tolerance for fascism or hate</li>
                <li>Equal dignity for all human beings</li>
                <li>Privacy: power to choose what we reveal</li>
              </ul>
            </div>

            <div class="bg-[#000080] border border-[#55ffff] p-3">
              <div class="text-[#55ff55] font-bold mb-1">2. BELIEVE IN GREATER PURPOSE</div>
              <ul class="text-[#aaaaaa] space-y-1 list-disc pl-4">
                <li>Serious movement, not just ephemeral meme</li>
                <li>Conviction forged in market winters</li>
                <li>Open creativity drives our community</li>
                <li>Knowledge shared freely without gatekeeping</li>
                <li>Make believers wealthy full-time advocates</li>
              </ul>
            </div>

            <div class="bg-[#000080] border border-[#55ffff] p-3">
              <div class="text-[#55ff55] font-bold mb-1">3. BUILD WHAT LASTS</div>
              <ul class="text-[#aaaaaa] space-y-1 list-disc pl-4">
                <li>Communities &gt; Technology</li>
                <li>Belief outlasts fleeting technical hype</li>
                <li>Decades, not days</li>
                <li>Technology serves humans, not vice versa</li>
                <li>Mathematical proofs secure our brotherhood</li>
              </ul>
            </div>

          </div>
        </div>

        <!-- The 10 Points of Brother Code -->
        <div class="bg-[#000000] border-2 border-[#55ffff] p-4 text-xs sm:text-sm">
          <div class="text-[#ffff55] font-bold text-base mb-3 text-center">
            --- THE 10 COMMANDMENTS OF THE BROTHER CODE ---
          </div>
          <div class="space-y-2 text-[#55ff55]">
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>01. WE ARE OPEN CREATORS.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="01. We are open creators. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>02. WE RESPECT AND HONOR ALL BROTHERS EQUALLY.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="02. We respect and honor all BROTHERS equally. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>03. WE PROTECT PRIVACY WHILE CELEBRATING OPENNESS.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="03. We protect privacy while celebrating openness. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>04. WE SHARE FREELY AND BUILD COLLECTIVELY.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="04. We share freely and build collectively. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>05. WE FOSTER INNOVATION THROUGH INCLUSION.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="05. We foster innovation through inclusion. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>06. WE RISE BY LIFTING OTHERS.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="06. We rise by lifting others. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>07. WE MAINTAIN UNWAVERING CONVICTION.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="07. We maintain unwavering conviction. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>08. WE CREATE GENUINE BELIEVERS.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="08. We create genuine believers. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>09. WE PROTECT OUR OWN.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="09. We protect our own. #BROTHER">TWEET.BAT</button>
            </div>
            <div class="flex items-center justify-between p-1 hover:bg-[#000080]">
              <span>10. WE BUILD FOR DECADES, NOT DAYS.</span>
              <button class="quote-x-btn text-xs text-[#ffff55] underline cursor-pointer" data-q="10. We build for decades, not days. #BROTHER">TWEET.BAT</button>
            </div>
          </div>
        </div>

        <!-- Closing Creed -->
        <div class="text-center pt-4 border-t border-[#55ffff]">
          <div class="text-[#ffff55] font-bold text-lg sm:text-xl font-dos">
            "A BROTHER ALONE IS STRONG. BROTHERS TOGETHER ARE UNSTOPPABLE."
          </div>
          <div class="mt-4 flex justify-center gap-4">
            <a href="/" class="win31-btn px-4 py-2 font-bold text-black text-xs">
              &lt; RETURN TO C:\PROMPT
            </a>
            <a href={TOKEN_CONFIG.avnuBuyUrl} target="_blank" class="win31-btn px-4 py-2 font-bold text-black text-xs bg-[#55ff55]">
              EXECUTE BUY_AVNU.SYS ↗
            </a>
          </div>
        </div>

      </div>

      <!-- DOS Edit Bottom Status Bar -->
      <div class="bg-[#c0c0c0] text-black px-3 py-1 flex items-center justify-between text-xs font-mono-code font-bold mt-6">
        <span>&lt;F1=HELP&gt; &lt;ESC=CANCEL&gt; &lt;ENTER=EXECUTE&gt;</span>
        <span>LINE: 10/10 // COL: 01 // 100% UNRUGGABLE</span>
      </div>

    </div>

  </main>

  <Footer />
</Layout>

<script>
  const tweetButtons = document.querySelectorAll('.quote-x-btn');
  tweetButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const q = btn.getAttribute('data-q') || '';
      const url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(q + ' https://www.supbro.fun/manifesto')}`;
      window.open(url, '_blank', 'width=550,height=420');
    });
  });
</script>
